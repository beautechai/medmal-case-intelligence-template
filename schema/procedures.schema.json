{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "procedures.schema.json",
  "title": "procedures",
  "description": "One row per procedure, wound event, consent or documentation event. Each CSV row is validated as one object.",
  "type": "object",
  "properties": {
    "proc_id": {"description": "Unique ID", "type": "string"},
    "date_of_service": {"description": "Date the procedure occurred (YYYY-MM-DD)", "type": "string", "pattern": "^(\\d{4}-\\d{2}-\\d{2})?$"},
    "start_time": {"description": "HH:MM", "type": "string"},
    "end_time": {"description": "HH:MM", "type": "string"},
    "procedure": {"description": "Procedure name as documented", "type": "string"},
    "category": {"description": "Type", "type": "string", "enum": ["incision", "wound_vac_placement", "wound_vac_change", "ostomy", "complication", "consent", "op_note", "anesthesia", "other", ""]},
    "site": {"description": "Anatomic site", "type": "string"},
    "extent": {"description": "Size/extent (e.g. length in cm, depth)", "type": "string"},
    "performed_by_role": {"description": "Role of operator", "type": "string"},
    "consent_signed_datetime": {"description": "When consent was signed (YYYY-MM-DD HH:MM)", "type": "string"},
    "consent_doc_id": {"description": "Consent document id", "type": "string"},
    "note_signed_datetime": {"description": "When the op/procedure note was signed (YYYY-MM-DD HH:MM)", "type": "string"},
    "note_filed_datetime": {"description": "When the note was filed/entered in the EHR per audit trail (YYYY-MM-DD HH:MM)", "type": "string"},
    "filing_lag_hours": {"description": "Computed hours from end of procedure to note filing", "type": ["number", "null"]},
    "facility": {"description": "Facility", "type": "string"},
    "encounter_id": {"description": "Encounter", "type": "string"},
    "source_doc_id": {"description": "Source document", "type": "string"},
    "page": {"description": "Page or Bates", "type": "string"},
    "notes": {"description": "Free text", "type": "string"}
  },
  "required": ["proc_id", "date_of_service", "procedure", "category"],
  "additionalProperties": true
}
